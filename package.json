{
  "name": "@dice-roller/convertor",
  "version": "1.0.0-alpha.0",
  "description": "Convert exported RPG Dice Roller data between schema versions.",
  "author": "GreenImp Media <info@greenimp.co.uk> (https://greenimp.co.uk)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dice-roller/convertor.git"
  },
  "bugs": {
    "url": "https://github.com/dice-roller/convertor/issues"
  },
  "homepage": "https://github.com/dice-roller/convertor#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watchAll",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "6.0.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "rpg-dice-roller-v5": "npm:@dice-roller/rpg-dice-roller@5",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
